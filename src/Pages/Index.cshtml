@{ViewData["Title"]="Find your next favourite.";ViewData["Page"]="home";}
<section class="fashion-hero"><div class="fashion-hero-copy"><span class="eyebrow">THE COLLECTION · LEBANON</span><h1>For the moment.<br/><em>For the memory.</em></h1><p>Discover Organza Al Ahmar's collection. Explore the photographs, find your favourites and start a conversation with the team.</p><a href="/shop" class="button">Explore the collection <span></span></a><div class="hero-meta"><span>EXPLORE THE COLLECTION</span><span>A PERSONAL CONVERSATION</span></div></div><div class="fashion-hero-image"><img src="@Shop.Settings.Hero" alt="From the Organza Al Ahmar collection" width="1080" height="1440" fetchpriority="high"/><span class="photo-label">THE ORGANZA AL AHMAR EDIT</span></div><span class="hero-decoration" aria-hidden="true">✳</span></section>
